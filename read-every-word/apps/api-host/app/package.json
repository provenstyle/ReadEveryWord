{
  "name": "@read-every-word/api-host",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "dependencies": {
    "@azure/functions": "^4.5.1"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/api-host/app/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "thirdParty": false,
          "main": "apps/api-host/app/src/main.ts",
          "tsConfig": "apps/api-host/app/tsconfig.app.json",
          "assets": [
            {
              "input": "apps/api-host/app",
              "glob": "host.json",
              "output": "."
            },
            {
              "input": "apps/api-host/app",
              "glob": ".funcignore",
              "output": "."
            }
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "deploy-manifest": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api-host/app/dist/package.json"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node apps/api-host/app/scripts/generate-deploy-manifest.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@read-every-word/api-host:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@read-every-word/api-host:build:development"
          },
          "production": {
            "buildTarget": "@read-every-word/api-host:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  }
}
