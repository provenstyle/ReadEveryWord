{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "ES2022",
    "types": ["node"],
    "rootDir": "src",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../../packages/azure-function-adapter/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/api/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/foundation/tsconfig.lib.json"
    }
  ]
}
